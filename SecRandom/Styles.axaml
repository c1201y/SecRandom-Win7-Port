<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:SecRandom.Views">
    <StyleInclude Source="avares://SecRandom.Core/StylesBase.axaml" />
    <Style Selector="PopupRoot">
        <Setter Property="views:SettingsNavigationPopupRoundedCornersBehavior.IsEnabled" Value="True" />
    </Style>
</Styles>
