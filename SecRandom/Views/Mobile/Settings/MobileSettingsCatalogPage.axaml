<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fa="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
             xmlns:sr="http://secrandom.sectl.cn/schemas/xaml/core"
             xmlns:local="clr-namespace:SecRandom.Views.Mobile.Settings"
             x:Class="SecRandom.Views.Mobile.Settings.MobileSettingsCatalogPage"
             x:DataType="local:MobileSettingsCatalogPage">
    <ScrollViewer x:Name="PageScroll">
        <ItemsControl ItemsSource="{Binding Items}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Classes="page-container" Orientation="Vertical" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <fa:SettingsExpander ItemsSource="{Binding Pages}"
                                           Header="{Binding Name}"
                                           Tag="{Binding PageId}"
                                           IsClickEnabled="{Binding IsPage}"
                                           ActionIconSource="{sr:FluentIconSource {sr:Fi ChevronRightFilled}}"
                                           Click="CatalogItem_OnClick">
                        <fa:SettingsExpander.IconSource>
                            <sr:FluentIconSource Glyph="{Binding IconGlyph}" />
                        </fa:SettingsExpander.IconSource>
                        <fa:SettingsExpander.ItemTemplate>
                            <DataTemplate>
                                <fa:SettingsExpanderItem Content="{Binding Name}"
                                                           Tag="{Binding Id}"
                                                           IsClickEnabled="True"
                                                           AutomationProperties.Name="{Binding Name}"
                                                           ActionIconSource="{sr:FluentIconSource {sr:Fi ChevronRightFilled}}"
                                                           Click="CatalogItem_OnClick">
                                    <fa:SettingsExpanderItem.IconSource>
                                        <sr:FluentIconSource Glyph="{Binding IconGlyph}" />
                                    </fa:SettingsExpanderItem.IconSource>
                                </fa:SettingsExpanderItem>
                            </DataTemplate>
                        </fa:SettingsExpander.ItemTemplate>
                    </fa:SettingsExpander>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </ScrollViewer>
</UserControl>
